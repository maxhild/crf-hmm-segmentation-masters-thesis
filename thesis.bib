@article{hann_entscheidungsunterstutzung_2025,
  abstract     = {Künstliche Intelligenz ({KI}) in der Gastroenterologie fand ihre ersten Anwendungsfälle in der Endoskopie. In diesem Beitrag beleuchten wir die Entstehungsgeschichte der {KI} für die Polypendetektion und -charakterisierung, ausgehend von Ergebnisse randomisierter klinischer Studien bis hin zu dem interessanten Fazit neuster Metaanalysen. Zusätzlich zeigen wir auf, welche Möglichkeiten {KI} für die Erfassung und Einhaltung von Qualitätsindikatoren bieten. Hier werden unter anderem der Tachometer für die Bestimmung der Geschwindigkeit beim Rückzug und die automatische Polypengrößenbestimmung thematisiert. Ebenfalls werden neue Methoden zur {KI}-basierten Charakterisierung und Visualisierung des Entzündungsgrads bei chronisch-entzündlichen Darmerkrankungen dargestellt. Weitere neue Produkte sind {KI}-basierte Diagnoseunterstützungssysteme für die Kapselendoskopie. Wir zeigen was neben einer deutlichen Zeitersparnis von den Systemen zu erwarten ist.},
  author       = {Hann, Alexander},
